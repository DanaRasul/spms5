// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  fullName  String
  email     String   @unique
  password  String
  role      UserRole @default(user_admin)
  enabled   Boolean  @default(true)
  branchId  String?
  createdAt DateTime @default(now())
  lastLogin DateTime?

  branch       ParkingLocation? @relation("BranchUsers", fields: [branchId], references: [id])
  activityLogs ActivityLog[]
  failedLogins FailedLogin[]

  @@index([role])
  @@index([branchId])
  @@index([enabled])
  @@index([createdAt])
  @@map("users")
}

model FailedLogin {
  id          String   @id @default(cuid())
  userId      String
  attemptedAt DateTime @default(now())
  lockedUntil DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([attemptedAt])
  @@map("failed_logins")
}

model ParkingLocation {
  id          String   @id @default(cuid())
  name        String
  address     String
  phoneNumber String?
  capacity    Int      @default(50)
  spacePrefix String   @default("S")
  status      LocationStatus @default(active)
  hourlyRate1 Float    @default(1000)
  hourlyRate2 Float    @default(1500)
  hourlyRate3 Float    @default(2000)
  createdAt   DateTime @default(now())

  users        User[]          @relation("BranchUsers")
  spaces       ParkingSpace[]
  vehicles     VehicleRecord[]
  subscribers  MonthlySubscriber[]
  activityLogs ActivityLog[]

  @@index([status])
  @@index([createdAt])
  @@map("parking_locations")
}

model ParkingSpace {
  id           String      @id @default(cuid())
  spaceNumber  String
  status       SpaceStatus @default(available)
  locationId   String

  location ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  vehicles VehicleRecord[]

  @@unique([spaceNumber, locationId])
  @@index([locationId])
  @@index([status])
  @@index([locationId, status])
  @@map("parking_spaces")
}

model VehicleRecord {
  id                String        @id @default(cuid())
  plateNumber       String
  parkingSpaceId    String
  parkingSpaceNumber String
  locationId        String
  entryDate         String
  entryTime         String
  exitDate          String?
  exitTime          String?
  duration          String?
  fee               Float?
  status            VehicleStatus @default(inside)
  driverName        String?
  vehicleType       String?
  vehicleColor      String?
  editHistory       Json?         @default("[]")
  loyaltyRewardUsed Boolean       @default(false)
  qrToken           String?       @unique
  receiptNumber     String?       @unique
  receiptGeneratedAt DateTime?
  createdAt         DateTime      @default(now())

  space    ParkingSpace    @relation(fields: [parkingSpaceId], references: [id])
  location ParkingLocation @relation(fields: [locationId], references: [id])

  @@index([qrToken])
  @@index([plateNumber])
  @@index([locationId])
  @@index([parkingSpaceId])
  @@index([status])
  @@index([locationId, status])
  @@index([plateNumber, status])
  @@index([createdAt])
  @@index([entryDate])
  @@map("vehicle_records")
}

model MonthlySubscriber {
  id                 String        @id @default(cuid())
  plateNumber        String
  driverName         String
  phoneNumber        String?
  vehicleType        String?
  vehicleColor       String?
  startDate          String
  subscriptionPeriod Int
  paymentAmount      Float
  notes              String?
  expirationDate     String
  remainingDays      Int
  paymentStatus      PaymentStatus @default(unpaid)
  locationId         String
  createdAt          DateTime      @default(now())

  location ParkingLocation @relation(fields: [locationId], references: [id])

  @@index([plateNumber])
  @@index([locationId])
  @@index([paymentStatus])
  @@index([locationId, paymentStatus])
  @@index([expirationDate])
  @@index([createdAt])
  @@map("monthly_subscribers")
}

model SystemSettings {
  id           String @id @default("default")
  totalCapacity Int   @default(50)
  hourlyRate1  Float  @default(1000)
  hourlyRate2  Float  @default(1500)
  hourlyRate3  Float  @default(2000)
  currency     String @default("IQD")
  timezone     String @default("Asia/Baghdad")
  defaultLocationId String?
  parkingName  String?
  address      String?
  phoneNumber  String?
  companyLogo  String?
  companyWebsite String?

  // Loyalty Program Settings
  loyaltyEnabled          Boolean @default(true)
  loyaltyVisitsRequired   Int     @default(10)
  loyaltyRewardType       String  @default("free_parking")
  loyaltyDiscountPercent  Float   @default(50)
  loyaltyFixedDiscount    Float   @default(0)
  loyaltyRewardExpireDays Int     @default(0)
  loyaltyIncludeSubscribers Boolean @default(false)

  @@map("system_settings")
}

model CustomerLoyalty {
  id                  String   @id @default(cuid())
  licensePlate        String   @unique
  customerName        String?
  phoneNumber         String?
  notes               String?  @db.Text
  totalVisits         Int      @default(0)
  availableRewards    Int      @default(0)
  totalRewardsEarned  Int      @default(0)
  totalRewardsRedeemed Int     @default(0)
  lastVisit           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  loyaltyLogs LoyaltyLog[]

  @@index([licensePlate])
  @@index([phoneNumber])
  @@index([totalVisits])
  @@index([availableRewards])
  @@index([lastVisit])
  @@index([createdAt])
  @@map("customer_loyalty")
}

model LoyaltyLog {
  id            String   @id @default(cuid())
  loyaltyId     String
  eventType     LoyaltyEventType
  description   String   @db.Text
  visitsBefore  Int      @default(0)
  visitsAfter   Int      @default(0)
  rewardsBefore Int      @default(0)
  rewardsAfter  Int      @default(0)
  vehicleRecordId String?
  performedBy   String?
  performedByRole String?
  ipAddress     String?
  timestamp     DateTime @default(now())

  loyalty CustomerLoyalty @relation(fields: [loyaltyId], references: [id], onDelete: Cascade)

  @@index([loyaltyId])
  @@index([eventType])
  @@index([timestamp])
  @@index([vehicleRecordId])
  @@map("loyalty_logs")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  username   String
  userRole   UserRole
  action     String   @db.Text
  category   String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  timestamp  DateTime @default(now())
  ipAddress  String?
  locationId String?

  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  location ParkingLocation? @relation(fields: [locationId], references: [id])

  @@index([userId])
  @@index([username])
  @@index([category])
  @@index([locationId])
  @@index([timestamp])
  @@index([locationId, timestamp])
  @@index([category, timestamp])
  @@map("activity_logs")
}

enum UserRole {
  system_admin
  branch_admin
  user_admin
}

enum LocationStatus {
  active
  inactive
}

enum SpaceStatus {
  available
  occupied
}

enum VehicleStatus {
  inside
  completed
}

enum PaymentStatus {
  paid
  unpaid
}

enum LoyaltyEventType {
  visit_added
  reward_earned
  reward_redeemed
  manual_adjustment
  reset_by_admin
  points_added
  points_removed
}
