generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  username     String           @unique
  fullName     String
  email        String           @unique
  password     String
  role         UserRole         @default(user_admin)
  enabled      Boolean          @default(true)
  branchId     String?
  createdAt    DateTime         @default(now())
  lastLogin    DateTime?
  activityLogs ActivityLog[]
  failedLogins FailedLogin[]
  branch       ParkingLocation? @relation("BranchUsers", fields: [branchId], references: [id])

  @@index([role])
  @@index([branchId])
  @@index([enabled])
  @@index([createdAt])
  @@map("users")
}

model FailedLogin {
  id          String    @id @default(cuid())
  userId      String
  attemptedAt DateTime  @default(now())
  lockedUntil DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([attemptedAt])
  @@map("failed_logins")
}

model ParkingLocation {
  id           String              @id @default(cuid())
  name         String
  address      String
  phoneNumber  String
  capacity     Int                 @default(50)
  status       LocationStatus      @default(active)
  createdAt    DateTime            @default(now())
  spacePrefix  String              @default("S")
  activityLogs ActivityLog[]
  subscribers  MonthlySubscriber[]
  spaces       ParkingSpace[]
  users        User[]              @relation("BranchUsers")
  vehicles     VehicleRecord[]

  @@index([status])
  @@index([createdAt])
  @@map("parking_locations")
}

model ParkingSpace {
  id          String          @id @default(cuid())
  spaceNumber String
  status      SpaceStatus     @default(available)
  locationId  String
  location    ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  vehicles    VehicleRecord[]

  @@unique([spaceNumber, locationId])
  @@index([locationId])
  @@index([status])
  @@index([locationId, status])
  @@map("parking_spaces")
}

model VehicleRecord {
  id                 String          @id @default(cuid())
  plateNumber        String
  parkingSpaceId     String
  parkingSpaceNumber String
  locationId         String
  entryDate          String
  entryTime          String
  exitDate           String?
  exitTime           String?
  duration           String?
  fee                Float?
  status             VehicleStatus   @default(inside)
  driverName         String?
  vehicleType        String?
  vehicleColor       String?
  editHistory        Json?
  createdAt          DateTime        @default(now())
  qrToken            String?         @unique
  location           ParkingLocation @relation(fields: [locationId], references: [id])
  space              ParkingSpace    @relation(fields: [parkingSpaceId], references: [id])

  @@index([plateNumber])
  @@index([locationId])
  @@index([parkingSpaceId])
  @@index([status])
  @@index([locationId, status])
  @@index([plateNumber, status])
  @@index([createdAt])
  @@index([entryDate])
  @@map("vehicle_records")
}

model MonthlySubscriber {
  id                 String          @id @default(cuid())
  plateNumber        String
  driverName         String
  phoneNumber        String
  vehicleType        String
  vehicleColor       String
  startDate          String
  subscriptionPeriod Int
  paymentAmount      Float
  notes              String?
  expirationDate     String
  remainingDays      Int
  paymentStatus      PaymentStatus   @default(unpaid)
  locationId         String
  createdAt          DateTime        @default(now())
  location           ParkingLocation @relation(fields: [locationId], references: [id])

  @@index([plateNumber])
  @@index([locationId])
  @@index([paymentStatus])
  @@index([locationId, paymentStatus])
  @@index([expirationDate])
  @@index([createdAt])
  @@map("monthly_subscribers")
}

model SystemSettings {
  id                String  @id @default("default")
  totalCapacity     Int     @default(50)
  hourlyRate1       Float   @default(1000)
  hourlyRate2       Float   @default(1500)
  hourlyRate3       Float   @default(2000)
  currency          String  @default("IQD")
  timezone          String  @default("Asia/Baghdad")
  defaultLocationId String?
  parkingName       String?
  address           String?
  phoneNumber       String?
  companyLogo       String?
  companyWebsite    String?

  @@map("system_settings")
}

model ActivityLog {
  id         String           @id @default(cuid())
  userId     String
  username   String
  userRole   UserRole
  action     String           @db.Text
  category   String
  oldValue   String?          @db.Text
  newValue   String?          @db.Text
  timestamp  DateTime         @default(now())
  ipAddress  String?
  locationId String?
  location   ParkingLocation? @relation(fields: [locationId], references: [id])
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([username])
  @@index([category])
  @@index([locationId])
  @@index([timestamp])
  @@index([locationId, timestamp])
  @@index([category, timestamp])
  @@map("activity_logs")
}

enum UserRole {
  system_admin
  branch_admin
  user_admin
}

enum LocationStatus {
  active
  inactive
}

enum SpaceStatus {
  available
  occupied
}

enum VehicleStatus {
  inside
  completed
}

enum PaymentStatus {
  paid
  unpaid
}
